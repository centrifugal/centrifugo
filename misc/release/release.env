# Release settings of this repository, loaded by .github/workflows/release.yml.
# GitHub repository the release is published to.
RELEASE_REPO=centrifugal/centrifugo
# GitHub repositories GoReleaser writes to (release, Homebrew tap).
PUBLISH_REPOS=centrifugal/centrifugo centrifugal/homebrew-centrifugo
# Release notes file.
RELEASE_NOTES=misc/release/notes.md
# packagecloud repository for DEB and RPM packages, empty to skip.
PACKAGECLOUD_REPO=FZambia/centrifugo
# Push Protobuf definitions to Buf Schema Registry.
PUBLISH_PROTOBUF=true

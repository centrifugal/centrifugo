{
  "description": "CLI commands: help, version, defaultconfig, defaultenv, configdoc, checkconfig, genconfig, token helpers.",
  "server": false,
  "steps": [
    {"op": "exec", "args": ["--help"]},
    {"op": "exec", "args": ["checkconfig", "--help"]},
    {"op": "exec", "args": ["checksubtoken", "--help"]},
    {"op": "exec", "args": ["checktoken", "--help"]},
    {"op": "exec", "args": ["completion", "--help"]},
    {"op": "exec", "args": ["configdoc", "--help"]},
    {"op": "exec", "args": ["defaultconfig", "--help"]},
    {"op": "exec", "args": ["defaultenv", "--help"]},
    {"op": "exec", "args": ["genconfig", "--help"]},
    {"op": "exec", "args": ["gensubtoken", "--help"]},
    {"op": "exec", "args": ["gentoken", "--help"]},
    {"op": "exec", "args": ["serve", "--help"]},
    {"op": "exec", "args": ["version", "--help"]},
    {"op": "exec", "args": ["unknowncommand"]},
    {"op": "exec", "args": ["version"]},
    {"op": "exec", "args": ["defaultconfig", "-d", "-c", "config.json"]},
    {"op": "exec", "args": ["defaultconfig", "-d", "-c", "config.yaml"]},
    {"op": "exec", "args": ["defaultconfig", "-d", "-c", "config.toml"]},
    {"op": "exec", "args": ["defaultconfig", "-d", "-c", "config.json", "-b", "base.json"], "files": {"base.json": "{\"client\":{\"token\":{\"hmac_secret_key\":\"cli-secret\"}},\"channel\":{\"namespaces\":[{\"name\":\"ns1\",\"presence\":true}]},\"proxies\":[{\"name\":\"p1\",\"endpoint\":\"http://localhost:3000\"}]}"}},
    {"op": "exec", "args": ["defaultconfig", "-c", "out.yaml"], "read_files": ["out.yaml"]},
    {"op": "exec", "args": ["defaultenv"]},
    {"op": "exec", "args": ["defaultenv", "-b", "base.json", "--base-non-zero-only"], "files": {"base.json": "{\"client\":{\"token\":{\"hmac_secret_key\":\"cli-secret\"}},\"channel\":{\"namespaces\":[{\"name\":\"ns1\",\"presence\":true}]}}"}},
    {"op": "exec", "args": ["configdoc", "-m"]},
    {"op": "exec", "args": ["configdoc", "-m", "-s", "client", "-l", "2"]},
    {"op": "exec", "args": ["checkconfig", "-c", "valid.json"], "files": {"valid.json": "{\"client\":{\"token\":{\"hmac_secret_key\":\"cli-secret\"}},\"channel\":{\"namespaces\":[{\"name\":\"ns1\"}]}}"}},
    {"op": "exec", "args": ["checkconfig", "-c", "valid.yaml"], "files": {"valid.yaml": "client:\n  token:\n    hmac_secret_key: cli-secret\nchannel:\n  namespaces:\n    - name: ns1\n"}},
    {"op": "exec", "args": ["checkconfig", "-c", "valid.toml"], "files": {"valid.toml": "[client.token]\nhmac_secret_key = \"cli-secret\"\n\n[[channel.namespaces]]\nname = \"ns1\"\n"}},
    {"op": "exec", "args": ["checkconfig", "-c", "invalid.json"], "files": {"invalid.json": "{\"channel\":{\"namespaces\":[{\"name\":\"bad name!\"}]}}"}},
    {"op": "exec", "args": ["checkconfig", "-c", "dup.json"], "files": {"dup.json": "{\"channel\":{\"namespaces\":[{\"name\":\"aa\"},{\"name\":\"aa\"}]}}"}},
    {"op": "exec", "args": ["checkconfig", "-c", "proxy.json"], "files": {"proxy.json": "{\"channel\":{\"namespaces\":[{\"name\":\"aa\",\"subscribe_proxy_enabled\":true,\"subscribe_proxy_name\":\"missing\"}]}}"}},
    {"op": "exec", "args": ["checkconfig", "-c", "engine.json"], "files": {"engine.json": "{\"engine\":{\"type\":\"bogus\"}}"}},
    {"op": "exec", "args": ["checkconfig", "-c", "unknown.json"], "files": {"unknown.json": "{\"client\":{\"bogus\":true}}"}},
    {"op": "exec", "args": ["checkconfig", "-c", "unknown.json", "--strict"], "files": {"unknown.json": "{\"client\":{\"bogus\":true}}"}},
    {"op": "exec", "args": ["checkconfig", "-c", "broken.json"], "files": {"broken.json": "{not json"}},
    {"op": "exec", "args": ["checkconfig", "-c", "missing.json"]},
    {"op": "exec", "args": ["genconfig"], "read_files": ["config.json"], "replace": {"\"(hmac_secret_key|password|secret|key)\": \"[^\"]+\"": "\"$1\": \"<random>\""}},
    {"op": "exec", "args": ["genconfig", "-c", "config.yaml"], "read_files": ["config.yaml"], "replace": {"(hmac_secret_key|password|secret|key): \\S+": "$1: <random>"}},
    {"op": "exec", "args": ["gentoken", "-c", "valid.json", "-u", "alice", "-t", "-1"], "files": {"valid.json": "{\"client\":{\"token\":{\"hmac_secret_key\":\"cli-secret\"}}}"}},
    {"op": "exec", "args": ["gentoken", "-c", "valid.json", "-u", "alice", "-q"], "files": {"valid.json": "{\"client\":{\"token\":{\"hmac_secret_key\":\"cli-secret\"}}}"}},
    {"op": "exec", "args": ["gensubtoken", "-c", "valid.json", "-u", "alice", "-s", "news", "-t", "-1"], "files": {"valid.json": "{\"client\":{\"token\":{\"hmac_secret_key\":\"cli-secret\"}}}"}},
    {"op": "exec", "args": ["gentoken", "-c", "missing.json", "-u", "alice"]},
    {"op": "exec", "args": ["checktoken", "-c", "valid.json", "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhbGljZSIsImluZm8iOnsiYSI6MX19.HCkIaMI25LzMg9UedIC_t8iCCSBsanC43s1ZDxwUlsU"], "files": {"valid.json": "{\"client\":{\"token\":{\"hmac_secret_key\":\"cli-secret\"}}}"}},
    {"op": "exec", "args": ["checktoken", "-c", "valid.json", "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhbGljZSIsImluZm8iOnsiYSI6MX19.HCkIaMI25LzMg9UedIC_t8iCCSBsanC43s1ZDxwUlsX"], "files": {"valid.json": "{\"client\":{\"token\":{\"hmac_secret_key\":\"cli-secret\"}}}"}},
    {"op": "exec", "args": ["checktoken", "-c", "valid.json"], "files": {"valid.json": "{\"client\":{\"token\":{\"hmac_secret_key\":\"cli-secret\"}}}"}},
    {"op": "exec", "args": ["checksubtoken", "-c", "valid.json", "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhbGljZSIsImNoYW5uZWwiOiJuZXdzIn0.MekALto9Gb145srzczHYUW1sOcH1NpEExGnXecrE_sk"], "files": {"valid.json": "{\"client\":{\"token\":{\"hmac_secret_key\":\"cli-secret\"}}}"}},
    {"op": "exec", "args": ["checksubtoken", "-c", "valid.json", "bad"], "files": {"valid.json": "{\"client\":{\"token\":{\"hmac_secret_key\":\"cli-secret\"}}}"}}
  ]
}

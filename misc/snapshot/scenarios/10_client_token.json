{
  "description": "Bidirectional WebSocket clients authenticated with JWT: subscribe, publish, history, presence, RPC, refresh, denials.",
  "variants": {
    "memory": {},
    "redis": {
      "requires": ["redis"],
      "config": {
        "engine": {
          "type": "redis",
          "redis": {"address": ["{{.RedisAddr}}"], "prefix": "{{.Unique}}"}
        }
      }
    }
  },
  "steps": [
    {"op": "connect", "client": "alice"},
    {"op": "send", "client": "alice", "cmd": {"connect": {"token": {"$jwt": {"sub": "alice", "exp": "$now+3600", "info": {"name": "Alice"}}}, "name": "snapshot", "version": "1.0.0"}}},
    {"op": "connect", "client": "bob"},
    {"op": "send", "client": "bob", "cmd": {"connect": {"token": {"$jwt": {"sub": "bob", "exp": "$now+3600"}}}}},
    {"op": "send", "client": "alice", "cmd": {"subscribe": {"channel": "chat"}}},
    {"op": "pushes", "client": "alice", "count": 1, "comment": "own join"},
    {"op": "send", "client": "bob", "cmd": {"subscribe": {"channel": "chat"}}},
    {"op": "pushes", "client": "alice", "count": 1, "comment": "join of bob"},
    {"op": "pushes", "client": "bob", "count": 1, "comment": "own join"},
    {"op": "send", "client": "alice", "cmd": {"publish": {"channel": "chat", "data": {"text": "hello"}}}},
    {"op": "pushes", "client": "alice", "count": 1},
    {"op": "pushes", "client": "bob", "count": 1},
    {"op": "send", "client": "alice", "cmd": {"history": {"channel": "chat", "limit": 10}}},
    {"op": "send", "client": "alice", "cmd": {"history": {"channel": "chat", "limit": -1}}},
    {"op": "send", "client": "alice", "cmd": {"presence": {"channel": "chat"}}},
    {"op": "send", "client": "alice", "cmd": {"presence_stats": {"channel": "chat"}}},
    {"op": "send", "client": "alice", "cmd": {"rpc": {"method": "ping"}}},
    {"op": "send", "client": "alice", "cmd": {"refresh": {"token": {"$jwt": {"sub": "alice", "exp": "$now+7200"}}}}},
    {"op": "send", "client": "alice", "cmd": {"subscribe": {"channel": "private:room", "token": {"$jwt": {"sub": "alice", "channel": "private:room", "exp": "$now+3600", "info": {"role": "admin"}}}}}},
    {"op": "send", "client": "alice", "cmd": {"sub_refresh": {"channel": "private:room", "token": {"$jwt": {"sub": "alice", "channel": "private:room", "exp": "$now+7200"}}}}},
    {"op": "send", "client": "alice", "cmd": {"subscribe": {"channel": "private:other"}}, "comment": "no token: permission denied"},
    {"op": "send", "client": "alice", "cmd": {"subscribe": {"channel": "nonexistent:x"}}, "comment": "unknown namespace"},
    {"op": "send", "client": "alice", "cmd": {"subscribe": {"channel": "pubsub:Bad-Name"}}, "comment": "channel_regex mismatch"},
    {"op": "send", "client": "alice", "cmd": {"subscribe": {"channel": "pubsub:room"}}},
    {"op": "send", "client": "alice", "cmd": {"subscribe": {"channel": "pubsub:room"}}, "comment": "already subscribed"},
    {"op": "send", "client": "alice", "cmd": {"publish": {"channel": "pubsub:room", "data": {"n": 1}}}},
    {"op": "pushes", "client": "alice", "count": 1},
    {"op": "send", "client": "bob", "cmd": {"publish": {"channel": "pubsub:room", "data": {"n": 2}}}, "comment": "publish allowed for client without subscription"},
    {"op": "pushes", "client": "alice", "count": 1},
    {"op": "send", "client": "bob", "cmd": {"publish": {"channel": "private:room", "data": {"n": 3}}}, "comment": "publish denied"},
    {"op": "send", "client": "alice", "cmd": {"presence": {"channel": "pubsub:room"}}, "comment": "presence not enabled"},
    {"op": "send", "client": "alice", "cmd": {"history": {"channel": "pubsub:room", "limit": 10}}},
    {"op": "send", "client": "alice", "cmd": {"history": {"channel": "private:room", "limit": 10}}, "comment": "history not allowed"},
    {"op": "send", "client": "alice", "cmd": {"unsubscribe": {"channel": "pubsub:room"}}},
    {"op": "send", "client": "alice", "cmd": {"unsubscribe": {"channel": "pubsub:room"}}, "comment": "not subscribed"},
    {"op": "send", "client": "alice", "cmd": {"subscribe": {"channel": "pubsub:room", "recover": true, "offset": 1, "epoch": "wrong"}}, "comment": "recovery with a wrong epoch"},
    {"op": "send", "client": "alice", "cmd": {"rpc": {"method": "grpc:unscripted"}}, "comment": "rpc via gRPC proxy without scripted answer"},
    {"op": "send", "client": "bob", "cmd": {"publish": {"channel": "chat", "data": {"text": "bye"}}}},
    {"op": "pushes", "client": "alice", "count": 1},
    {"op": "pushes", "client": "bob", "count": 1},
    {"op": "close", "client": "bob"},
    {"op": "pushes", "client": "alice", "count": 1, "comment": "leave of bob"},

    {"op": "connect", "client": "anon"},
    {"op": "send", "client": "anon", "cmd": {"connect": {}}, "comment": "no token, anonymous not allowed"},
    {"op": "connect", "client": "badsig"},
    {"op": "send", "client": "badsig", "cmd": {"connect": {"token": {"$jwt": {"sub": "x"}, "secret": "wrong"}}}},
    {"op": "connect", "client": "expired"},
    {"op": "send", "client": "expired", "cmd": {"connect": {"token": {"$jwt": {"sub": "x", "exp": "$now-100"}}}}},
    {"op": "close", "client": "expired"},
    {"op": "connect", "client": "garbage"},
    {"op": "send", "client": "garbage", "cmd": {"bogus": {}}},
    {"op": "connect", "client": "early"},
    {"op": "send", "client": "early", "cmd": {"subscribe": {"channel": "chat"}}, "comment": "command before connect"},
    {"op": "connect", "client": "origin", "headers": {"Origin": "http://evil.example"}},
    {"op": "connect", "client": "c2"},
    {"op": "send", "client": "c2", "cmd": {"connect": {"token": {"$jwt": {"sub": "carol", "exp": "$now+3600"}}}}},
    {"op": "send", "client": "c2", "cmd": {"subscribe": {"channel": "private:room2", "token": {"$jwt": {"sub": "carol", "channel": "private:room3", "exp": "$now+3600"}}}}, "comment": "token for another channel"},
    {"op": "connect", "client": "c3"},
    {"op": "send", "client": "c3", "cmd": {"connect": {"token": {"$jwt": {"sub": "carol", "exp": "$now+3600"}}}}},
    {"op": "send", "client": "c3", "cmd": {"subscribe": {"channel": "private:room4", "token": "not-a-jwt"}}, "comment": "malformed sub token"},
    {"op": "connect", "client": "c4"},
    {"op": "send", "client": "c4", "cmd": {"connect": {"token": {"$jwt": {"sub": "carol", "exp": "$now+3600"}}}}},
    {"op": "send", "client": "c4", "cmd": {"subscribe": {"channel": "private:room5", "token": {"$jwt": {"sub": "dave", "channel": "private:room5", "exp": "$now+3600"}}}}, "comment": "sub token of another user"},
    {"op": "send", "client": "alice", "cmd": {"refresh": {"token": {"$jwt": {"sub": "eve", "exp": "$now+7200"}}}}, "comment": "refresh with a token of another user"},
    {"op": "metrics"}
  ]
}

{
  "description": "Server HTTP API: every common method, batch, broadcast, map operations, errors and auth; effects seen by a subscribed client.",
  "variants": {
    "default": {},
    "transport_errors": {
      "config": {"http_api": {"error_mode": "transport"}}
    }
  },
  "steps": [
    {"op": "connect", "client": "watcher"},
    {"op": "send", "client": "watcher", "cmd": {"connect": {"token": {"$jwt": {"sub": "watcher", "exp": "$now+3600"}}}}},
    {"op": "send", "client": "watcher", "cmd": {"subscribe": {"channel": "news"}}},
    {"op": "pushes", "client": "watcher", "count": 1, "comment": "own join"},
    {"op": "api", "method": "publish", "body": {"channel": "news", "data": {"text": "one"}, "tags": {"k": "v"}}},
    {"op": "pushes", "client": "watcher", "count": 1},
    {"op": "api", "method": "publish", "body": {"channel": "news", "data": {"text": "two"}, "idempotency_key": "idem-1"}},
    {"op": "api", "method": "publish", "body": {"channel": "news", "data": {"text": "two"}, "idempotency_key": "idem-1"}, "comment": "same idempotency key"},
    {"op": "pushes", "client": "watcher", "count": 1},
    {"op": "api", "method": "publish", "body": {"channel": "news", "data": {"text": "skip"}, "skip_history": true}},
    {"op": "pushes", "client": "watcher", "count": 1},
    {"op": "api", "method": "publish", "body": {"channel": "bin", "b64data": "aGVsbG8="}, "comment": "binary data"},
    {"op": "api", "method": "history", "body": {"channel": "bin", "limit": 10}, "comment": "binary data in a JSON response"},
    {"op": "api", "method": "broadcast", "body": {"channels": ["news", "other", "unknown:x"], "data": {"text": "broadcast"}}},
    {"op": "pushes", "client": "watcher", "count": 1},
    {"op": "api", "method": "history", "body": {"channel": "news", "limit": 10}},
    {"op": "api", "method": "history", "body": {"channel": "news", "limit": 1, "reverse": true}},
    {"op": "api", "method": "history", "body": {"channel": "news", "limit": 10, "since": {"offset": 1, "epoch": "wrong-epoch"}}},
    {"op": "api", "method": "history_remove", "body": {"channel": "news"}},
    {"op": "api", "method": "history", "body": {"channel": "news", "limit": 10}},
    {"op": "api", "method": "presence", "body": {"channel": "news"}},
    {"op": "api", "method": "presence_stats", "body": {"channel": "news"}},
    {"op": "api", "method": "channels", "body": {}},
    {"op": "api", "method": "channels", "body": {"pattern": "ne*"}},
    {"op": "api", "method": "info", "body": {}, "comment": "node info"},
    {"op": "api", "method": "subscribe", "body": {"user": "watcher", "channel": "server-sub", "data": {"why": "api"}}},
    {"op": "pushes", "client": "watcher", "count": 2, "sort": true},
    {"op": "api", "method": "unsubscribe", "body": {"user": "watcher", "channel": "server-sub"}},
    {"op": "pushes", "client": "watcher", "count": 1},
    {"op": "api", "method": "refresh", "body": {"user": "watcher", "expire_at": 4102444800}},
    {"op": "pushes", "client": "watcher", "count": 1},
    {"op": "api", "method": "rpc", "body": {"method": "getUserStatus", "params": {}}},
    {"op": "api", "method": "batch", "body": {"commands": [
      {"publish": {"channel": "news", "data": {"text": "batch1"}}},
      {"publish": {"channel": "unknown:x", "data": {}}},
      {"broadcast": {"channels": ["news"], "data": {"text": "batch2"}}},
      {"presence_stats": {"channel": "news"}},
      {"history": {"channel": "news", "limit": 10}}
    ]}},
    {"op": "pushes", "client": "watcher", "count": 2},
    {"op": "api", "method": "batch", "body": {"commands": [
      {"publish": {"channel": "par1", "data": {"text": "batch3"}}},
      {"publish": {"channel": "par2", "data": {"text": "batch4"}}}
    ], "parallel": true}},
    {"op": "api", "method": "map_publish", "body": {"channel": "mapns:board", "key": "k1", "data": {"v": 1}}},
    {"op": "api", "method": "map_publish", "body": {"channel": "mapns:board", "key": "k2", "data": {"v": 2}}},
    {"op": "api", "method": "map_read_state", "body": {"channel": "mapns:board", "limit": 10}},
    {"op": "api", "method": "map_read_stream", "body": {"channel": "mapns:board", "limit": 10}},
    {"op": "api", "method": "map_stats", "body": {"channel": "mapns:board"}},
    {"op": "api", "method": "map_remove", "body": {"channel": "mapns:board", "key": "k1"}},
    {"op": "api", "method": "map_read_state", "body": {"channel": "mapns:board", "limit": 10}},
    {"op": "api", "method": "map_clear", "body": {"channel": "mapns:board"}},
    {"op": "api", "method": "map_publish", "body": {"channel": "news", "key": "k1", "data": {"v": 1}}, "comment": "map op on a stream channel"},
    {"op": "api", "method": "publish", "body": {"channel": "unknown:x", "data": {}}, "comment": "unknown namespace"},
    {"op": "api", "method": "publish", "body": {"channel": "", "data": {}}, "comment": "empty channel"},
    {"op": "api", "method": "publish", "body": {"channel": "news"}, "comment": "no data"},
    {"op": "api", "method": "publish", "body": {"channel": "pubsub:Bad-Name", "data": {}}, "comment": "channel regex"},
    {"op": "api", "method": "publish", "raw_body": "{not json", "comment": "malformed body"},
    {"op": "api", "method": "publish", "body": {"channel": "news", "data": {}}, "auth": "bad", "comment": "wrong key"},
    {"op": "api", "method": "publish", "body": {"channel": "news", "data": {}}, "auth": "none", "comment": "no key"},
    {"op": "api", "method": "publish", "body": {"channel": "news", "data": {}}, "auth": "apikey snapshot-api-key", "comment": "Authorization header"},
    {"op": "pushes", "client": "watcher", "count": 1},
    {"op": "api", "method": "nonexistent", "body": {}, "comment": "unknown method"},
    {"op": "api", "path": "/api", "body": {"method": "publish", "params": {"channel": "news", "data": {"text": "legacy"}}}, "comment": "legacy route"},
    {"op": "pushes", "client": "watcher", "count": 1},
    {"op": "api", "path": "/api", "body": {"method": "bogus", "params": {}}, "comment": "legacy route, unknown method"},
    {"op": "api", "method": "publish", "body": {"channel": "news", "b64data": "aGVsbG8="}, "comment": "binary data to a JSON client"},
    {"op": "wait_close", "client": "watcher"},
    {"op": "connect", "client": "w2"},
    {"op": "send", "client": "w2", "cmd": {"connect": {"token": {"$jwt": {"sub": "w2", "exp": "$now+3600"}}}}},
    {"op": "api", "method": "disconnect", "body": {"user": "w2", "disconnect": {"code": 4100, "reason": "kicked"}}},
    {"op": "wait_close", "client": "w2"},
    {"op": "api", "method": "presence_stats", "body": {"channel": "news"}},
    {"op": "metrics", "filter": "^centrifugo_api"}
  ]
}
